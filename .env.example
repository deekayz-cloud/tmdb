# TMDB API Read Access Token (Bearer Token, nicht der v3 API Key)
TMDB_BEARER_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=de-DE

# Wohin die Bilder + JSON-Manifeste geschrieben werden (relativ zum Repo-Root)
OUTPUT_ROOT=docs

# Basis-URL, unter der OUTPUT_ROOT letztlich per GitHub Pages erreichbar ist
SITE_BASE_URL=https://deekayz-cloud.github.io/tmdb
